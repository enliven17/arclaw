# arclaw environment. Copy to .env.local. Nothing here is a secret: NEXT_PUBLIC_* values ship to the browser.

# Arc network: testnet (default) or mainnet. Mainnet has no arclaw deployment yet.
# NEXT_PUBLIC_ARC_NETWORK=testnet

# Comma list of Arc RPCs tried in order (viem fallback). Defaults to the public RPC of the network.
# NEXT_PUBLIC_ARC_RPC_URL=

# Privy (dashboard.privy.io): login (email code, Google, X) with embedded wallets, plus external wallets. Without
# the app id the app still runs and the connect sheet says wallets are not configured. The client id is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Optional: your own WalletConnect Cloud project id (Privy falls back to its own when empty).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin for absolute URLs in metadata and share cards.
# APP_ORIGIN=https://arclaw.app

# Telegram bot (scripts/telegram-setup.mjs registers the webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: override the mp4 played on /start (default: /video/launch-square.mp4)
TELEGRAM_LAUNCH_VIDEO_URL=
