# arclaw environment. Copy to .env.local. Nothing here is a secret: NEXT_PUBLIC_* values ship to the browser.

# Solana network: devnet (default) or mainnet. Mainnet has no arclaw deployment yet.
# NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC (defaults to the public RPC of the network; use a private one in production).
# NEXT_PUBLIC_SOLANA_RPC_URL=

# MagicBlock ephemeral rollup the claw rounds run on, and the validator rounds are delegated to. They must match:
# devnet-as.magicblock.app is MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57 (the delegation program's default, so the
# validator can stay empty). Pick another region by setting both.
# NEXT_PUBLIC_MAGICBLOCK_RPC_URL=https://devnet-as.magicblock.app
# NEXT_PUBLIC_MAGICBLOCK_VALIDATOR=

# Mainnet until lib/deployments/solana-mainnet.json is filled: the deployment JSON (same shape) inline.
# NEXT_PUBLIC_SOLANA_MAINNET_DEPLOYMENT=

# The Convex deployment for the leaderboard (convex/indexer.ts). Without it the page reads the chain directly.
# NEXT_PUBLIC_CONVEX_URL=

# Public origin for absolute URLs in metadata and share cards.
# APP_ORIGIN=https://arclaw.app

# Telegram bot (scripts/ops/telegram-setup.mjs registers the webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: override the mp4 played on /start (default: /video/launch-square.mp4)
TELEGRAM_LAUNCH_VIDEO_URL=

# Signs the shared-pull links (openssl rand -hex 32). Server only. Without it sharing is off.
SHARE_SECRET=

# scripts/solana/setup.ts (devnet): the admin keypair file (default ~/.config/solana/id.json) and the RPC.
# SOLANA_KEYPAIR=~/.config/solana/id.json
