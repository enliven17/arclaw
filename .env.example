# arclaw environment. Copy to .env.local. Nothing here is a secret: NEXT_PUBLIC_* values ship to the browser.

# Arc network: testnet (default) or mainnet. Mainnet has no arclaw deployment yet.
# NEXT_PUBLIC_ARC_NETWORK=testnet

# Comma list of Arc RPCs tried in order (viem fallback). Defaults to the public RPC of the network.
# NEXT_PUBLIC_ARC_RPC_URL=

# Privy (dashboard.privy.io): login (email code, Google, X) with embedded wallets, plus external wallets. Without
# the app id the app still runs and the connect sheet says wallets are not configured. The client id is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Optional: your own WalletConnect Cloud project id (Privy falls back to its own when empty).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin for absolute URLs in metadata and share cards.
# APP_ORIGIN=https://arclaw.app

# Telegram bot (scripts/telegram-setup.mjs registers the webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: override the mp4 played on /start (default: /video/launch-square.mp4)
TELEGRAM_LAUNCH_VIDEO_URL=

# Signs the shared-pull links (openssl rand -hex 32). Server only. Without it sharing is off.
SHARE_SECRET=

# Keeper bot (lib/keeper, docs/OPERATIONS.md). Set these in the Convex env (npx convex env set ...) for the crons, or
# in .env.keeper for the CLI (pnpm keeper ...). KEEPER_PRIVATE_KEY is a hot key: it holds gas only and is Arclaw's
# operator and a keeper, nothing else. Never commit it. Without it the Convex keeper actions do nothing.
KEEPER_PRIVATE_KEY=
# Dry runs without a key: the keeper address to simulate from.
# KEEPER_ADDRESS=
# testnet (default: NEXT_PUBLIC_ARC_NETWORK) | mainnet
# KEEPER_NETWORK=testnet
# Comma list of RPCs; use a private one in production.
# KEEPER_RPC_URL=
# Mainnet until lib/arc/config.ts knows it: the deployment JSON (lib/deployments shape) inline.
# KEEPER_DEPLOYMENT_JSON=
# Second price source checked before every reprice: astock (mainnet default) | off (testnet default) | https://...
# KEEPER_PRICE_CHECK=astock
# 1: simulate everything, sign nothing.
# KEEPER_DRY_RUN=
# Keeper gas balance under which health warns (USDC, default 1); the most it adds to a VRF retry (default 0.1).
# KEEPER_MIN_GAS_USDC=1
# KEEPER_MAX_VRF_TOPUP_USDC=0.1
# Reprices per machine per UTC day before the keeper stops and alerts (machines are only repriced when used).
# KEEPER_MAX_REPRICES_PER_DAY=6
# Alerts go to this chat through TELEGRAM_BOT_TOKEN (the bot must be in the chat).
ALERT_TELEGRAM_CHAT_ID=
